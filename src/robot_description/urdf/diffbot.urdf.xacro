<?xml version="1.0"?>
<robot name="diffbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_link_length" value="0.30"/>
    <xacro:property name="base_link_width" value="0.20"/>
    <xacro:property name="base_link_height" value="0.12"/>
    <xacro:property name="wheel_radius" value="0.05"/>
    <xacro:property name="wheel_thickness" value="0.02"/>
    <xacro:property name="axle_offset" value="0.0"/>
    <xacro:property name="mass_body" value="2.0"/>
    <xacro:property name="mass_wheel" value="0.1"/>

    <xacro:property name="cam_offset_x" value="0.12"/>
    <xacro:property name="cam_offset_z" value="0.08"/>
    <xacro:property name="cam_tilt" value="0.15"/>

    <link name="base_link">
    <visual>
        <origin xyz="0 0 0.08" rpy="0 0 0"/>
        <geometry>
            <box size="0.30 0.20 0.12"/>
        </geometry>
        <material name="body_color">
            <color rgba="0.2 0.2 0.2 1"/>   <!-- 深灰色，不透明 -->
        </material>
    </visual>
    <collision>
        <origin xyz="0 0 0.08" rpy="0 0 0"/>
        <geometry>
            <box size="0.30 0.20 0.12"/>
        </geometry>
    </collision>
    <inertial>
        <origin xyz="0 0 0.08" rpy="0 0 0"/>
        <mass value="2.0"/>
        <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    </link>

      <!-- ========== 轮子宏 ========== -->
  <xacro:macro name="wheel" params="name y">
    <link name="${name}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5707 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
        </geometry>
        <material name="wheel_color">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5707 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="${mass_wheel}"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                 iyy="0.0001" iyz="0.0"
                 izz="0.0001"/>
      </inertial>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <origin xyz="${axle_offset} ${y} ${wheel_radius}" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <axis xyz = "0 1 0" />
      <dynamics damping="0.05" friction="0.01"/>
    </joint>

    <gazebo reference="${name}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <fdir1>1 0 0</fdir1>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>1.0</maxVel>
    </gazebo>
  </xacro:macro>

  <!-- 左轮 y 为正、右轮 y 为负（ROS 右手系：x 前，y 左，z 上） -->
  <xacro:wheel name="left"  y="0.11"/>
  <xacro:wheel name="right" y="-0.11"/>

  <!-- ========== 前支撑轮 ========== -->
  <link name="front_caster_link">
    <visual>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="caster_color">
        <color rgba="0.4 0.4 0.4 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
               izz="0.00001"/>
    </inertial>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <origin xyz="0.12 0 0.025"/>
    <parent link="base_link"/>
    <child link="front_caster_link"/>
  </joint>

  <gazebo reference="front_caster_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>

    <!-- ========== 后支撑轮 ========== -->
  <link name="back_caster_link">
    <visual>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="caster_color">
        <color rgba="0.4 0.4 0.4 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
               izz="0.00001"/>
    </inertial>
  </link>

  <joint name="back_caster_joint" type="fixed">
    <origin xyz="-0.12 0 0.025"/>
    <parent link="base_link"/>
    <child link="back_caster_link"/>
  </joint>

  <gazebo reference="back_caster_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>

    <!-- ========== 摄像头 ========== -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.03 0.03 0.03"/>
      </geometry>
      <material name="camera_color">
        <color rgba="0.8 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.03 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
               izz="0.00001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="${cam_offset_x} 0 ${cam_offset_z}" rpy="0 ${cam_tilt} 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

  <!-- 光学坐标系：与 camera_link 位置相同，只旋转坐标轴 -->
  <link name="camera_link_optical"/>

  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707 0 -1.5707"/>
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
  </joint>

  <!-- ========== Gazebo 相机插件 ========== -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/</namespace>
        </ros>
        <frame_name>camera_link_optical</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ========== 激光雷达 ========== -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.02"/>
      </geometry>
      <material name="lidar_color">
        <color rgba="0.1 0.1 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
               izz="0.00001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
  </joint>

  <!-- ========== Gazebo 激光雷达插件 ========== -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="ray">
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

    <!-- ========== 差速驱动插件 ========== -->
  <gazebo>
    <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>cmd_vel:=/cmd_vel</remapping>
        <remapping>odom:=/odom</remapping>
      </ros>

      <update_rate>30</update_rate>

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.22</wheel_separation>
      <wheel_diameter>0.10</wheel_diameter>

      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>

      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <!-- 轮子 TF 由 robot_state_publisher 发布；插件再发一份会让 Nav2 节点
           持续报 TF_OLD_DATA（Nav2 用不到轮子 TF，关掉可消除刷屏） -->
      <publish_wheel_tf>false</publish_wheel_tf>
    </plugin>
  </gazebo>

</robot>
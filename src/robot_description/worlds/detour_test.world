<?xml version="1.0"?>
<sdf version="1.6">
  <world name="detour_test">

    <!-- ========== 物理与光照 ========== -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ========== 地面（浅色，高对比度） ========== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <emissive>0.9 0.9 0.9 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========== 四面围墙（深色） ========== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8 0.1 1.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>8 0.1 1.0</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8 0.1 1.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>8 0.1 1.0</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-4 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 8 1.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.1 8 1.0</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>4 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 8 1.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.1 8 1.0</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========== 绕行验证用障碍物 ========== -->
    <!-- 放在机器人直行路径正中间（y=0），北/南两侧空间对称（各约 3.65m） -->
    <!-- 北边缘 y=0.25，南边缘 y=-0.25，机器人可任选一侧绕行 -->
    <model name="detour_box">
      <static>true</static>
      <pose>0.5 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

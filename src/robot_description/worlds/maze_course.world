<?xml version="1.0"?>
<sdf version="1.6">
  <world name="maze_course">

    <!-- ========== Gazebo Sim 系统插件 ========== -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <!-- 相机/激光雷达等渲染传感器必须由 Sensors 系统插件驱动 -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ========== 物理与光照 ========== -->
    <physics type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ========== 地面（浅色，保证视觉阈值法可通行） ========== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <emissive>0.9 0.9 0.9 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========== 迷宫墙体（5x5 完美迷宫，1.2m 走廊，1 个出口） ========== -->
    <!-- 起点格 (0.0, 0.0)；出口在第 (4, 1) 格 E 侧外墙 -->
    <model name="wall_v_0_1">
      <static>true</static>
      <pose>-1.800 -1.200 0.500 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.100 1.200 1.000</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.100 1.200 1.000</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_v_0_2">
      <static>true</static>
      <pose>-1.800 0.000 0.500 0 0 0</pose>
      <link name="link">
